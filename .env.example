# ================================================
# Secret CFW Platform - Environment Configuration
# ================================================

# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/secretcfw?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# Discord OAuth Configuration
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Discord Bot Configuration
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-server-id"

# Discord Role IDs (for role-based permissions)
# الإدارة العليا - Full access
DISCORD_ROLE_SUPER_ADMIN="role-id-super-admin"
# إدارة التفعيل - Application review access
DISCORD_ROLE_ACTIVATION_ADMIN="role-id-activation-admin"
# إدارة عامة - General admin access
DISCORD_ROLE_GENERAL_ADMIN="role-id-general-admin"
# رتبة الأولوية - Priority test access
DISCORD_ROLE_PRIORITY="role-id-priority"
# رتبة المفعلين - Approved users
DISCORD_ROLE_ACTIVATED="role-id-activated"

# Discord Channel IDs
# قناة إشعارات الإدارة
DISCORD_CHANNEL_ADMIN_NOTIFICATIONS="channel-id-admin-notifications"
# قناة لوق العمليات
DISCORD_CHANNEL_LOGS="channel-id-logs"
# قناة داشبورد التفعيل
DISCORD_CHANNEL_ACTIVATION_DASHBOARD="channel-id-dashboard"

# Application Settings
# عدد الأسئلة في الاختبار
QUESTIONS_PER_TEST="5"
# الحد الأدنى لعمر حساب ديسكورد (بالأيام)
MIN_ACCOUNT_AGE_DAYS="7"
# وقت انتظار بين الطلبات (بالساعات)
WAIT_TIME_HOURS="24"

# Security Settings
# تفعيل وضع الصيانة
MAINTENANCE_MODE="false"
# تفعيل كشف الحسابات البديلة
ALT_DETECTION_ENABLED="true"

# Optional: Analytics
# ANALYTICS_ID=""
