# Secret CFW - متغيرات البيئة
# ================================

# قاعدة البيانات PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/secretcfw?schema=public"

# إعدادات NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here-min-32-chars"

# إعدادات Discord OAuth
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# إعدادات البوت
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-guild-id"

# معرفات الرتب الإدارية
SUPER_ADMIN_ROLE_ID="your-super-admin-role-id"
ACTIVATION_ADMIN_ROLE_ID="your-activation-admin-role-id"
GENERAL_ADMIN_ROLE_ID="your-general-admin-role-id"

# رتبة الأولوية
PRIORITY_ROLE_ID="your-priority-role-id"

# رتبة التفعيل (تُمنح عند القبول)
ACTIVATED_ROLE_ID="your-activated-role-id"

# قنوات الديسكورد
ACTIVATION_LOG_CHANNEL_ID="your-activation-log-channel-id"
ADMIN_NOTIFICATIONS_CHANNEL_ID="your-admin-notifications-channel-id"
DASHBOARD_CHANNEL_ID="your-dashboard-channel-id"

# إعدادات الأمان
MIN_ACCOUNT_AGE_DAYS="7"
MAX_APPLICATIONS_PER_DAY="3"

# بيئة التشغيل
NODE_ENV="development"
