# =============================================
# Secret CFW Platform - Environment Variables
# =============================================

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/secret_cfw?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-generate-with-openssl-rand-base64-32"

# Discord OAuth
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Discord Bot
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-guild-id"

# Discord Role IDs (for permissions)
DISCORD_SUPER_ADMIN_ROLE_ID="super-admin-role-id"
DISCORD_ACTIVATION_ADMIN_ROLE_ID="activation-admin-role-id"
DISCORD_GENERAL_ADMIN_ROLE_ID="general-admin-role-id"
DISCORD_PRIORITY_ROLE_ID="priority-role-id"
DISCORD_ACTIVATED_ROLE_ID="activated-player-role-id"

# Discord Channel IDs
DISCORD_ACTIVATION_CHANNEL_ID="activation-dashboard-channel-id"
DISCORD_ADMIN_NOTIFICATIONS_CHANNEL_ID="admin-notifications-channel-id"
DISCORD_LOGS_CHANNEL_ID="logs-channel-id"

# Security Settings
MIN_ACCOUNT_AGE_DAYS=7
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_MS=60000

# Application Settings
QUESTIONS_PER_EXAM=5
