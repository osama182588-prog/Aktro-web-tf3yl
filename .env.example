# ================================
# Secret CFW - Environment Variables
# منصة إدارة تفعيل اللاعبين
# ================================

# ============ قاعدة البيانات ============
DATABASE_URL="postgresql://user:password@localhost:5432/secretcfw?schema=public"

# ============ NextAuth ============
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here-change-in-production"

# ============ Discord OAuth ============
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ============ Discord Bot ============
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-server-id"

# ============ Discord Channels ============
DISCORD_LOG_CHANNEL_ID="channel-id-for-logs"
DISCORD_ADMIN_NOTIFICATION_CHANNEL_ID="channel-id-for-admin-notifications"
DISCORD_ACTIVATION_DASHBOARD_CHANNEL_ID="channel-id-for-activation-dashboard"

# ============ Discord Roles ============
# رتبة الإدارة العليا - صلاحيات كاملة
DISCORD_ROLE_SENIOR_ADMIN="role-id"

# رتبة إدارة التفعيل - مراجعة الطلبات
DISCORD_ROLE_ACTIVATION_ADMIN="role-id"

# رتبة الإدارة العامة - إدارة الأسئلة والإعدادات
DISCORD_ROLE_GENERAL_ADMIN="role-id"

# رتبة المفعل - تُعطى بعد القبول
DISCORD_ROLE_ACTIVATED="role-id"

# رتبة الأولوية - أولوية في المراجعة
DISCORD_ROLE_PRIORITY="role-id"

# ============ إعدادات التفعيل ============
# عدد الأسئلة في الاختبار
ACTIVATION_QUESTIONS_COUNT="5"

# الحد الأدنى لعمر حساب Discord (بالأيام)
MIN_ACCOUNT_AGE_DAYS="7"

# الحد الأدنى للعمر المسموح
MIN_AGE="16"

# ============ إعدادات الأمان ============
# مدة انتظار إعادة التقديم بعد الرفض (بالساعات)
RESUBMIT_COOLDOWN_HOURS="24"

# الحد الأقصى للطلبات المتكررة
MAX_REQUESTS_PER_DAY="3"

# ============ إعدادات النظام ============
# وضع الصيانة
MAINTENANCE_MODE="false"

# رسالة الصيانة
MAINTENANCE_MESSAGE="النظام تحت الصيانة، يرجى المحاولة لاحقاً"
