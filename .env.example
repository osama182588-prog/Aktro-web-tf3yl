# Secret CFW Platform - Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL="postgresql://user:password@localhost:5432/secret_cfw?schema=public"

# ============================================
# NextAuth Configuration
# ============================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# ============================================
# Discord OAuth Configuration
# ============================================
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"

# ============================================
# Discord Bot Configuration
# ============================================
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_GUILD_ID="your-discord-server-id"

# ============================================
# Discord Role IDs (Admin Roles)
# ============================================
# High Admin - Full permissions
DISCORD_HIGH_ADMIN_ROLE_ID="role-id-for-high-admin"

# Activation Admin - Can review and decide on requests
DISCORD_ACTIVATION_ADMIN_ROLE_ID="role-id-for-activation-admin"

# General Admin - Can manage questions and some settings
DISCORD_GENERAL_ADMIN_ROLE_ID="role-id-for-general-admin"

# Priority Role - Gets priority in review queue
DISCORD_PRIORITY_ROLE_ID="role-id-for-priority"

# Activated Role - Given to activated users
DISCORD_ACTIVATED_ROLE_ID="role-id-for-activated-users"

# ============================================
# Discord Channel IDs
# ============================================
# Admin notifications channel for new requests, approvals, rejections
DISCORD_ADMIN_NOTIFICATIONS_CHANNEL_ID="channel-id-for-admin-notifications"

# Dashboard channel where the bot posts the persistent status message
DISCORD_DASHBOARD_CHANNEL_ID="channel-id-for-dashboard"

# Logs channel for all bot activities
DISCORD_LOGS_CHANNEL_ID="channel-id-for-logs"

# ============================================
# Security Settings
# ============================================
# Minimum Discord account age in days
MIN_ACCOUNT_AGE_DAYS=7

# Cooldown between requests in hours (after rejection)
REQUEST_COOLDOWN_HOURS=24

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================
# Activation Settings
# ============================================
# Number of questions in the activation test
ACTIVATION_TEST_QUESTION_COUNT=5

# Minimum character story length
MIN_STORY_LENGTH=100

# Maximum character story length  
MAX_STORY_LENGTH=2000

# ============================================
# Application Settings
# ============================================
# Site name
SITE_NAME="Secret CFW"

# Default theme (light/dark)
DEFAULT_THEME="dark"

# Maintenance mode (true/false)
MAINTENANCE_MODE="false"

# ============================================
# FiveM Integration (Optional)
# ============================================
FIVEM_SERVER_CFX_KEY=""
FIVEM_SERVER_ENDPOINT=""
