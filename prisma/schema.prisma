// Prisma schema for Secret CFW Platform
// نظام Secret CFW لإدارة تفعيل اللاعبين

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// المستخدم - User Model
model User {
  id            String    @id @default(cuid())
  discordId     String    @unique
  username      String
  discriminator String?
  avatar        String?
  email         String?
  roles         String[]  @default([])
  
  // صلاحيات المستخدم
  isAdmin       Boolean   @default(false)
  adminRole     AdminRole @default(NONE)
  
  // معلومات الحساب
  accountAge    DateTime?
  isPriority    Boolean   @default(false)
  
  // العلاقات
  applications  Application[]
  adminLogs     AdminLog[]
  reviewedApps  Application[] @relation("ReviewedBy")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// صلاحيات الإدارة
enum AdminRole {
  NONE          // لا صلاحية
  GENERAL_ADMIN // إدارة عامة
  ACTIVATION_ADMIN // إدارة التفعيل
  SUPER_ADMIN   // إدارة عليا
}

// حالات التفعيل
enum ApplicationStatus {
  PENDING     // غير مفعل
  REVIEWING   // قيد المراجعة
  APPROVED    // مفعل
  REJECTED    // مرفوض
  MODIFICATION_REQUIRED // طلب تعديل
}

// نموذج طلب التفعيل
model Application {
  id              String            @id @default(cuid())
  
  // معلومات المتقدم
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  
  // بيانات التقديم
  realName        String
  age             Int
  characterName   String
  characterStory  String            @db.Text
  
  // إجابات الأسئلة
  answers         Json              // {questionId: answer}
  
  // حالة الطلب
  status          ApplicationStatus @default(PENDING)
  isPriority      Boolean           @default(false)
  qualityRating   Int?              // تصنيف جودة الطلب 1-5
  
  // ملاحظات الإدارة
  adminNotes      String?           @db.Text
  internalNotes   String?           @db.Text
  rejectionReason String?           @db.Text
  
  // المراجع
  reviewedById    String?
  reviewedBy      User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  
  // التواريخ
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

// بنك الأسئلة
model Question {
  id          String   @id @default(cuid())
  question    String   @db.Text
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// سجل العمليات الإدارية
model AdminLog {
  id          String   @id @default(cuid())
  
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  
  action      String
  targetType  String   // application, question, user, settings
  targetId    String?
  details     Json?
  
  createdAt   DateTime @default(now())
}

// إعدادات النظام
model Settings {
  id                    String   @id @default("settings")
  
  // إعدادات التفعيل
  questionsPerTest      Int      @default(5)
  maintenanceMode       Boolean  @default(false)
  minAccountAge         Int      @default(7) // بالأيام
  
  // إعدادات التصميم
  primaryColor          String   @default("#3B82F6")
  secondaryColor        String   @default("#6B7280")
  darkMode              Boolean  @default(true)
  customBackground      String?
  
  // ردود سريعة
  quickResponses        Json     @default("[]")
  
  // إعدادات أخرى
  serverName            String   @default("Secret CFW")
  serverLogo            String?
  welcomeMessage        String?  @db.Text
  
  updatedAt             DateTime @updatedAt
}

// النسخ الاحتياطي
model Backup {
  id          String   @id @default(cuid())
  filename    String
  size        Int
  type        String   // full, applications, questions
  
  createdAt   DateTime @default(now())
}

// إشعارات داخلية
model Notification {
  id          String   @id @default(cuid())
  
  userId      String?  // null = للجميع
  title       String
  message     String   @db.Text
  type        String   // info, success, warning, error
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())
}
